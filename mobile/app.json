{
  "expo": {
    "name": "SamePoint",
    "slug": "samepoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/same-point-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/same-point-logo.png",
      "bundleIdentifier": "com.view.samepoint",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mobile",
              "com.googleusercontent.apps.161519798851-n33nmncp21l1e2qlatho6m5lcub1ugrc"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/same-point-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.view.samepoint"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/icon/same-point-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/icon/same-point-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.161519798851-n33nmncp21l1e2qlatho6m5lcub1ugrc"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cc07fc5e-c4b3-4c73-a8df-61d8e42a9243"
      }
    }
  }
}
